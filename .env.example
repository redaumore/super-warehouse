# ---- Database (Postgres + pgvector) ----
# Copy this file to .env and set a real password. .env is gitignored and
# never committed. DATABASE_URL is optional; when unset it is derived from
# the POSTGRES_* values below.
POSTGRES_USER=ferreteria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ferreteria

# ---- App ----
# Secret used to sign/verify webhook payloads (WhatsApp + Telegram).
WEBHOOK_SECRET=change-me
# How long (minutes) a soft-lock reservation is held before auto-release.
RESERVATION_TTL_MINUTES=30

# ---- WhatsApp (Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Telegram demo channel ----
TELEGRAM_BOT_TOKEN=

# ---- OpenAI (STT / Vision / embeddings) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# ---- Feature flags: stop at a Fase boundary ----
FASE1_ENABLED=true
FASE2_ENABLED=true
FASE3_ENABLED=true
FASE4_ENABLED=true

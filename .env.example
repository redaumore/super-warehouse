# ---- Database (Postgres + pgvector) ----
POSTGRES_USER=ferreteria
POSTGRES_PASSWORD=ferreteria
POSTGRES_DB=ferreteria
DATABASE_URL=postgresql+psycopg://ferreteria:ferreteria@localhost:5432/ferreteria

# ---- App ----
# Secret used to sign/verify webhook payloads (WhatsApp + Telegram).
WEBHOOK_SECRET=change-me
# How long (minutes) a soft-lock reservation is held before auto-release.
RESERVATION_TTL_MINUTES=30

# ---- WhatsApp (Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Telegram demo channel ----
TELEGRAM_BOT_TOKEN=

# ---- OpenAI (STT / Vision / embeddings) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# ---- Feature flags: stop at a Fase boundary ----
FASE1_ENABLED=true
FASE2_ENABLED=true
FASE3_ENABLED=true
FASE4_ENABLED=true

# ---- Database (Postgres + pgvector) ----
# Copy this file to .env and set a real password. .env is gitignored and
# never committed. DATABASE_URL is optional; when unset it is derived from
# the POSTGRES_* values below.
POSTGRES_USER=ferreteria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ferreteria

# ---- App ----
# Secret used to sign/verify webhook payloads (WhatsApp + Telegram).
WEBHOOK_SECRET=change-me
# How long (minutes) a soft-lock reservation is held before auto-release.
RESERVATION_TTL_MINUTES=30

# ---- Owner sender allowlist (the ONLY chat actor) ----
# Every inbound message is gated against these keys before routing. Telegram
# senders are chat ids; WhatsApp senders are phone numbers (any format). When
# both are empty the gate is open and the legacy customer intake keeps working.
OWNER_TELEGRAM_CHAT_ID=
OWNER_WHATSAPP_PHONE=
# DEPRECATED: legacy owner notification target (quotes/cancellations pushed over
# Telegram). Kept parseable so old .env files still load; the push was removed —
# replies now travel in the owner's chat. Do not use for new setups.

# ---- WhatsApp (Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Telegram demo channel ----
TELEGRAM_BOT_TOKEN=
# Secret token Telegram echoes in X-Telegram-Bot-Api-Secret-Token (set via
# setWebhook). Empty = demo mode (accept any webhook).
TELEGRAM_SECRET_TOKEN=

# ---- OpenAI (STT / Vision / embeddings) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# ---- Google Sheets (append-only order registration) ----
# Path to a gspread service-account JSON and the spreadsheet key. When unset,
# order rows are quarantined instead of blocking the approval flow.
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SPREADSHEET_KEY=

# ---- Supplier-catalog RAG (fase-0-pdf-parsing service) ----
# Base URL and request tuning for POST /api/v1/query. The service runs on 8001
# (some docs still say 8000 — the default below is the live port).
RAG_BASE_URL=http://localhost:8001
RAG_TIMEOUT_SECONDS=10
RAG_TOP_N=3
RAG_THRESHOLD=0.45
RAG_TABLE_NAME=catalogo_productos_rag
RAG_MODEL=gpt-4o

# ---- Feature flags: stop at a Fase boundary ----
# Fase 1 foundation, 2 core agents/orchestrator, 3 integrations, 4 backoffice.
FASE1_ENABLED=true
FASE2_ENABLED=true
FASE3_ENABLED=true
FASE4_ENABLED=true
